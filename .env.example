# Copy to .env.local and fill only the values you use. Never commit .env.local.

# Telegram Bot API.
TELEGRAM_BOT_TOKEN=
TG_RADAR_ADMIN_CHAT_IDS=

# Telegram user API / gotd session.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_PASSWORD=

# Local service paths and public URL.
TG_RADAR_ADDR=:8080
TG_RADAR_DB=data/tg-radar.db
TG_RADAR_SESSION=data/telegram.session
TG_RADAR_PUBLIC_URL=http://localhost:8080

# Dedicated bearer token used by the Codex plugin and /mcp endpoint.
# Generate with: openssl rand -hex 32
TG_RADAR_MCP_TOKEN=
