# Copy to .env.local and fill only the values you use. Never commit .env.local.

# Telegram Bot API.
TELEGRAM_BOT_TOKEN=

# Telegram user API. Users connect their own accounts with /login in the bot.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Encrypts stored Telegram sessions. Generate with: openssl rand -base64 32
TELEGRAM_BRIDGE_SESSION_KEY=

# Local service paths and public URL.
TELEGRAM_BRIDGE_ADDR=:8080
TELEGRAM_BRIDGE_DB=data/telegram-bridge.db
TELEGRAM_BRIDGE_PUBLIC_URL=http://localhost:8080

# OAuth for MCP clients with approval in the bot: on or off (default).
# Requires TELEGRAM_BOT_TOKEN and TELEGRAM_BRIDGE_PUBLIC_URL.
# TELEGRAM_BRIDGE_OAUTH=on
# Client secret from @BotFather -> the bot -> Login Widget. Allowed URL:
# <TELEGRAM_BRIDGE_PUBLIC_URL>/oauth/telegram/callback
TELEGRAM_LOGIN_CLIENT_SECRET=
# Extra exact HTTPS redirect URIs besides loopback and the Claude callback.
# TELEGRAM_BRIDGE_OAUTH_REDIRECT_URIS=

# Upgrading a single-account deployment only: the session file and these values
# are imported once for the account that owns the session. Remove them afterwards.
TELEGRAM_BRIDGE_SESSION=data/telegram.session
TELEGRAM_BRIDGE_MCP_TOKEN=
TELEGRAM_BRIDGE_NOTIFICATION_TOKEN=
TELEGRAM_BRIDGE_NOTIFICATION_CHAT_IDS=

# Explicit paid media processing, entirely inside the Fly service.
# Production key belongs in Fly Secrets; never commit it.
OPENROUTER_API_KEY=
TELEGRAM_BRIDGE_MEDIA_ENABLED=false
TELEGRAM_BRIDGE_MEDIA_CONCURRENCY=3
TELEGRAM_BRIDGE_MEDIA_DIR=data/media
TELEGRAM_BRIDGE_AUDIO_MODEL=openai/gpt-transcribe
TELEGRAM_BRIDGE_IMAGE_MODEL=openai/gpt-4.1-mini
TELEGRAM_BRIDGE_MEDIA_CACHE_REVISION=1
TELEGRAM_BRIDGE_MEDIA_MAX_BYTES=20971520
TELEGRAM_BRIDGE_MEDIA_MAX_SECONDS=600
TELEGRAM_BRIDGE_MEDIA_MAX_DISK_BYTES=209715200
TELEGRAM_BRIDGE_MEDIA_RETENTION_HOURS=24
TELEGRAM_BRIDGE_MEDIA_DAILY_BUDGET_MICROUSD=1000000
TELEGRAM_BRIDGE_MEDIA_TOTAL_BUDGET_MICROUSD=5000000
