# Copy to .env.local and fill only the values you use. Never commit .env.local.

# Telegram Bot API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BRIDGE_ADMIN_CHAT_IDS=

# Telegram user API / gotd session.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_PASSWORD=

# Local service paths and public URL.
TELEGRAM_BRIDGE_ADDR=:8080
TELEGRAM_BRIDGE_DB=data/telegram-bridge.db
TELEGRAM_BRIDGE_SESSION=data/telegram.session
TELEGRAM_BRIDGE_PUBLIC_URL=http://localhost:8080

# Dedicated bearer token used by the Codex plugin and /mcp endpoint.
# Generate with: openssl rand -hex 32
TELEGRAM_BRIDGE_MCP_TOKEN=

# Dedicated API token for notifications; never reuse MCP or worker tokens.
# Generate with: openssl rand -hex 32
TELEGRAM_BRIDGE_NOTIFICATION_TOKEN=

# Notifications use the already-authorized user account. Empty disables the API.
# Comma-separated negative Bot API group IDs, verified with getChat before sending.
TELEGRAM_BRIDGE_NOTIFICATION_CHAT_IDS=

# Separate bearer token for the Mac worker that talks to /worker/v1.
TELEGRAM_BRIDGE_WORKER_TOKEN=
